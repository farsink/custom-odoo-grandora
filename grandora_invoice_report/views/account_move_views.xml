<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_grandora_invoice_report" model="ir.ui.view">
        <field name="name">account.move.form.grandora.invoice.report</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='due_date']" position="after">
                <field name="sale_order_number" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')" readonly="state != 'draft'"/>
                <field name="division_name" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')" readonly="state != 'draft'"/>
                <field name="delivery_time" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
