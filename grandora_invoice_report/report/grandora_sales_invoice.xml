<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_grandora" inherit_id="account.report_invoice_document" priority="1000">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="delivery_partner" t-value="o._grandora_delivery_partner()"/>
            <t t-set="report_lines" t-value="o._grandora_report_lines()"/>
            <style>
                .grandora-invoice-page, .grandora-invoice-page * { box-sizing: border-box; }
                .grandora-invoice-page {
                    width: 210mm;
                    min-height: 297mm;
                    height: 297mm;
                    padding: 20px 24px;
                    background: #fff;
                    color: #000;
                    font-family: "Times New Roman", Times, serif;
                    font-size: 12px;
                    line-height: 1.25;
                    display: flex;
                    flex-direction: column;
                }
                .grandora-invoice-page header,
                .grandora-invoice-page .grandora-divider,
                .grandora-invoice-page .grandora-title-row,
                .grandora-invoice-page .grandora-details,
                .grandora-invoice-page .grandora-footer { flex: 0 0 auto; }
                .grandora-flex { display: flex; }
                .grandora-grid { display: grid; }
                .grandora-between { justify-content: space-between; }
                .grandora-center { text-align: center; }
                .grandora-right { text-align: right; }
                .grandora-bold { font-weight: 700; }
                .grandora-maroon { color: #8a151b; }
                .grandora-gold { color: #b0966a; }
                .grandora-pink { background: #f3e6ea; }
                .grandora-table-head { background: #e8ccce; }
                .grandora-header { align-items: center; margin-bottom: 8px; padding-top: 4px; }
                .grandora-brand-block { width: 38%; display: flex; align-items: center; gap: 8px; }
                .grandora-lettermark { width: 58px; height: 58px; object-fit: contain; flex: 0 0 auto; }
                .grandora-wordmark { flex: 1 -2 auto; text-align: center; line-height: 1.12; }
                .grandora-wordmark-logo { width: 100%; max-height: 44px; object-fit: contain; display: block; }
                .grandora-wordmark-web { margin-top: 4px; font-size: 12px; font-weight: 700; }
                .grandora-company { width: 38%; padding: 0 0 0 8px; font-size: 11px; }
                .grandora-ar { width: 24%; padding-top: 2px; text-align: right; }
                .grandora-ar-title { font-size: 34px; line-height: .95; font-weight: 700; }
                .grandora-ar-subtitle { font-size: 16px; font-weight: 700; color: #b0966a; }
                .grandora-divider { height: 3px; background: #8a151b; margin-bottom: 4px; }
                .grandora-title-row { align-items: flex-end; margin-bottom: 4px; }
                .grandora-title-row &gt; div { width: 33.33%; }
                .grandora-title { width: 33.33%; text-align: center; font-size: 24px; font-weight: 400; letter-spacing: .025em; }
                .grandora-box { border: 1px solid #000; }
                .grandora-details { grid-template-columns: 1.2fr 1.2fr 1fr; margin-bottom: 8px; }
                .grandora-panel { min-height: 140px; padding: 8px 16px 8px 8px; border-right: 1px solid #000; display: flex; flex-direction: column; justify-content: space-between; }
                .grandora-panel:last-child { border-right: 0; padding: 4px 8px 8px; display: block; }
                .grandora-meta { margin-bottom: 8px; }
                .grandora-meta-title { display: flex; justify-content: center; align-items: center; padding: 6px 8px; border-top: 2px solid #000; border-bottom: 2px solid #000; text-align: center; font-size: 16px; letter-spacing: .02em; }
                .grandora-meta-row { display: grid; grid-template-columns: 1.2fr 1fr; border-bottom: 1px solid #000; }
                .grandora-meta-row:last-child { border-bottom: 0; }
                .grandora-meta-cell { min-height: 86px; padding: 7px 10px; }
                .grandora-meta-cell:first-child { border-right: 1px solid #000; }
                .grandora-meta-heading { font-weight: 700; margin-bottom: 5px; }
                .grandora-meta-address { min-height: 40px; }
                .grandora-meta-contact { margin-top: 4px; }
                .grandora-meta-kv { display: grid; grid-template-columns: 112px 10px 1fr; row-gap: 4px; align-items: start; }
                .grandora-kv { display: grid; grid-template-columns: 80px 10px 1fr; row-gap: 2px; align-items: start; }
                .grandora-kv-small { display: grid; grid-template-columns: 50px 10px 1fr; row-gap: 2px; }
                .grandora-kv-right { display: grid; grid-template-columns: 90px 10px 1fr; row-gap: 2px; align-items: start; }
                .grandora-mt { margin-top: 4px; }
                .grandora-mb { margin-bottom: 4px; }
                .grandora-mb2 { margin-bottom: 8px; }
                .grandora-lines-wrap { border: 1px solid #000; border-bottom: 0; flex: 1 1 auto; min-height: 0; display: flex; }
                .grandora-lines { width: 100%; height: 100%; border-collapse: collapse; table-layout: fixed; font-size: 11px; }
                .grandora-lines th, .grandora-lines td { border-left: 1px solid #000; border-right: 1px solid #000; padding: 5px 6px; vertical-align: top; }
                .grandora-lines th { border-bottom: 1px solid #000; text-align: center; font-weight: 400; }
                .grandora-lines th:first-child, .grandora-lines td:first-child { border-left: 0; padding-left: 2px; padding-right: 2px; }
                .grandora-lines th:last-child, .grandora-lines td:last-child { border-right: 0; }
                .grandora-lines .grandora-sl-head { line-height: 1.05; white-space: normal; }
                .grandora-fill-row { height: 100%; }
                .grandora-fill-row td { height: 100%; padding: 0 8px; }
                .grandora-footer { border: 1px solid #000; }
                .grandora-words { display: flex; align-items: center; border-bottom: 1px solid #000; padding: 8px; min-height: 31px; }
                .grandora-words-left { flex: 1 1 auto; display: flex; gap: 8px; }
                .grandora-words-left .label { width: 64px; }
                .grandora-words-total { flex: 0 0 240px; display: flex; justify-content: space-between; gap: 18px; padding-left: 16px; font-weight: bold; }
                .grandora-remarks { padding: 8px; border-bottom: 1px solid #000; align-items: center; }
                .grandora-remarks .label { width: 96px; font-size: 13px; font-weight: 700; }
                .grandora-remarks .text { flex: 1; text-align: center; white-space: pre-line; }
                .grandora-bottom { grid-template-columns: 1.5fr 1.5fr 1fr; min-height: 140px; }
                .grandora-bottom-panel { padding: 8px; border-right: 1px solid #000; }
                .grandora-bottom-panel:last-child { border-right: 0; }
                .grandora-terms { font-size: 10px; line-height: 1.25; }
                .grandora-terms h3 { margin: 0 0 4px; font-size: 11px; }
                .grandora-terms ol { margin: 0; padding-left: 14px; }
                .grandora-terms li { margin-bottom: 4px; }
                .grandora-receipt { display: flex; flex-direction: column; justify-content: space-between; }
                .grandora-sign-line { display: flex; align-items: end; gap: 8px; margin-top: 10px; }
                .grandora-sign-line .line { flex: 1; border-bottom: 1px solid #000; height: 16px; }
                .grandora-delivered { display: flex; flex-direction: column; }
                .grandora-delivered-box { height: 48px; }
                @page { size: A4; margin: 0; }
            </style>
            <div class="article grandora-invoice-page" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" t-att-data-oe-lang="o.env.context.get('lang')">
                <header class="grandora-flex grandora-between grandora-header">
                    <div class="grandora-brand-block grandora-maroon">
                        <img src="/grandora_invoice_report/static/src/img/grandora_letter_mark.png" alt="Grandora lettermark" class="grandora-lettermark"/>
                        <div class="grandora-wordmark">
                            <img src="/grandora_invoice_report/static/src/img/grandora_logo.png" alt="Grandora Gourmet Trading" class="grandora-wordmark-logo"/>
                            <div class="grandora-wordmark-web">www.grandoragourmet.com</div>
                        </div>
                    </div>
                    <div class="grandora-company grandora-maroon">
                        <div class="grandora-bold" style="font-size:13.5px; margin-bottom:4px;">Grandora Gourmet Trading W.L.L</div>
                        <div>Tel : <span t-esc="o.company_id.phone or '30302234'"/></div>
                        <div>P.O. Box : <span t-esc="o.company_id.zip or '30264'"/></div>
                        <div><span t-esc="o.company_id.city or 'Doha'"/> - <span t-esc="o.company_id.country_id.name or 'Qatar'"/></div>
                        <div>Email : <span t-esc="o.company_id.email or 'info@grandoragourmet.com'"/></div>
                    </div>
                    <div class="grandora-ar grandora-maroon">
                        <div class="grandora-ar-title" dir="rtl">جراندورا</div>
                        <div class="grandora-ar-subtitle" dir="rtl">لتجارة المواد الغذائية</div>
                    </div>
                </header>

                <div class="grandora-divider"></div>

                <div class="grandora-box grandora-meta">
                    <div class="grandora-meta-title grandora-bold">
                        <span>SALES INVOICE</span>
                    </div>
                    <div class="grandora-meta-row">
                        <div class="grandora-meta-cell">
                            <div class="grandora-meta-heading">INVOICE TO:</div>
                            <div class="grandora-meta-address">
                                <span t-esc="o.partner_id.name or ''"/>
                                <span t-if="o.partner_id.ref"> (Customer ID: <span t-esc="o.partner_id.ref"/>)</span><br/>
                                <span t-if="not o.partner_id.ref"><br/></span>
                                <span t-if="o.partner_id.street" t-esc="o.partner_id.street"/><br t-if="o.partner_id.street"/>
                                <span t-if="o.partner_id.street2" t-esc="o.partner_id.street2"/><br t-if="o.partner_id.street2"/>
                                <span t-if="o.partner_id.city" t-esc="o.partner_id.city"/><span t-if="o.partner_id.city and o.partner_id.country_id">, </span><span t-esc="o.partner_id.country_id.name or ''"/>
                            </div>
                            <div class="grandora-meta-contact">Tel no: <span t-esc="o.partner_id.phone or o.partner_id.mobile or '-'"/></div>
                        </div>
                        <div class="grandora-meta-cell">
                            <div class="grandora-meta-kv">
                                <div>INVOICE NO</div><div>:</div><div t-esc="o.name if o.name and o.name != '/' else 'Draft'"/>
                                <div>DATE</div><div>:</div><div t-esc="o.invoice_date and o.invoice_date.strftime('%d/%m/%Y') or ''"/>
                                <div>CURRENCY</div><div>:</div><div t-esc="o.currency_id.name or ''"/>
                                <div>P.O. NUMBER</div><div>:</div><div t-esc="o.ref or '-'"/>
                            </div>
                        </div>
                    </div>
                    <div class="grandora-meta-row">
                        <div class="grandora-meta-cell">
                            <div class="grandora-meta-heading">DELIVERY TO:</div>
                            <div class="grandora-meta-address">
                                <span t-esc="delivery_partner.name or o.partner_id.name or ''"/>
                                <span t-if="delivery_partner.street2 or delivery_partner.city"> (Area: <span t-esc="delivery_partner.street2 or delivery_partner.city"/>)</span><br/>
                                <span t-if="not (delivery_partner.street2 or delivery_partner.city)"><br/></span>
                                <span t-if="delivery_partner.street" t-esc="delivery_partner.street"/><br t-if="delivery_partner.street"/>
                                <span t-if="delivery_partner.street2" t-esc="delivery_partner.street2"/><br t-if="delivery_partner.street2"/>
                                <span t-if="delivery_partner.city" t-esc="delivery_partner.city"/><span t-if="delivery_partner.city and delivery_partner.country_id">, </span><span t-esc="delivery_partner.country_id.name or ''"/>
                            </div>
                            <div class="grandora-meta-contact">Tel no: <span t-esc="delivery_partner.phone or delivery_partner.mobile or '-'"/></div>
                        </div>
                        <div class="grandora-meta-cell">
                            <div class="grandora-meta-kv">
                                <div>SALES PERSON</div><div>:</div><div t-esc="o.invoice_user_id.name or o.user_id.name or '-'"/>
                                <div>TERMS</div><div>:</div><div t-esc="o.invoice_payment_term_id.name or '-'"/>
                                <div>SO NUMBER</div><div>:</div><div t-esc="o.sale_order_number or o.invoice_origin or '-'"/>
                                <div>PRINTED</div><div>:</div><div t-esc="o._grandora_printed_at()"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grandora-lines-wrap">
                    <table class="grandora-lines">
                        <colgroup>
                            <col style="width:5%;"/>
                            <col style="width:10%;"/>
                            <col style="width:47%;"/>
                            <col style="width:8%;"/>
                            <col style="width:10%;"/>
                            <col style="width:10%;"/>
                            <col style="width:10%;"/>
                        </colgroup>
                        <thead>
                            <tr class="grandora-table-head">
                                <th class="grandora-sl-head">SL.<br/>No.</th>
                                <th>CODE</th>
                                <th>DESCRIPTION</th>
                                <th>UOM</th>
                                <th>QUANTITY</th>
                                <th>PRICE</th>
                                <th>AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="report_lines" t-as="line">
                                <tr>
                                    <td class="grandora-center" t-esc="line_index + 1"/>
                                    <td class="grandora-center" t-esc="line.product_id.default_code or '-'"/>
                                    <td><span t-esc="o._grandora_line_description(line)"/></td>
                                    <td class="grandora-center" t-esc="line.product_uom_id.name or ''"/>
                                    <td class="grandora-right" t-esc="'%.3f' % line.quantity"/>
                                    <td class="grandora-right" t-esc="'%.2f' % line.price_unit"/>
                                    <td class="grandora-right" t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
                                </tr>
                            </t>
                            <t t-if="not report_lines">
                                <tr><td colspan="7" class="grandora-center">No invoice lines</td></tr>
                            </t>
                            <tr class="grandora-fill-row"><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="grandora-footer">
                    <div class="grandora-words">
                        <div class="grandora-words-left">
                            <span class="label">In words</span><span>:</span>
                            <span><span t-esc="o.currency_id.name"/> &amp;nbsp;&amp;nbsp;&amp;nbsp; *** <span t-esc="o.amount_total_words or o.currency_id.amount_to_text(o.amount_total)"/></span>
                        </div>
                        <div class="grandora-words-total">
                            <span>Total</span>
                            <span t-esc="o.currency_id.name"/>
                            <span t-esc="'{:,.2f}'.format(o.amount_total)"/>
                        </div>
                    </div>
                    <div class="grandora-flex grandora-remarks grandora-table-head">
                        <div class="label">Remarks</div>
                        <div class="text">
                            <span t-esc="o.grandora_remarks or ''"/>
                        </div>
                        <div class="label grandora-right" dir="rtl">ملاحظات</div>
                    </div>
                    <!-- Compatibility anchors for Odoo's invoice layout preview inheritance. -->
                    <div style="display: none;">
                        <div id="qrcode"></div>
                        <p name="payment_communication"><t t-if="o.partner_bank_id"></t></p>
                    </div>
                    <div class="grandora-grid grandora-bottom">
                        <div class="grandora-bottom-panel grandora-terms">
                            <h3 class="grandora-bold">TERMS &amp; CONDITIONS</h3>
                            <ol>
                                <li>Goods must be inspected upon delivery. No claims for shortages, damages, or incorrect deliveries will be accepted after receipt and acknowledgment.</li>
                                <li>Goods sold are non-returnable and non-exchangeable except for approved quality defects.</li>
                                <li>Payments must be made according to the agreed terms and in favour of Grandora Gourmet Trading.</li>
                                <li>Grandora Gourmet Trading is not responsible for goods that are improperly stored or used after their expiry date.</li>
                            </ol>
                        </div>
                        <div class="grandora-bottom-panel grandora-receipt">
                            <div class="grandora-flex grandora-between grandora-mb2">
                                <span>Customer Receipt</span><span dir="rtl" class="grandora-bold">إيصال العميل</span>
                            </div>
                            <div class="grandora-flex grandora-between grandora-mb2" style="font-size:11px;">
                                <span style="width:60%;">Received in good condition except as Stated above.</span>
                                <span dir="rtl" class="grandora-right grandora-bold" style="width:40%;">استلمت البضاعة في حالة جيدة ماعدا ماهو مدون أعلاه.</span>
                            </div>
                            <div>
                                <div class="grandora-sign-line"><span style="width:56px;">Signature</span><div class="line"></div><span dir="rtl" class="grandora-right grandora-bold" style="width:56px;">التوقيع</span></div>
                                <div class="grandora-sign-line"><span style="width:56px;">Name</span><div class="line"></div><span dir="rtl" class="grandora-right grandora-bold" style="width:56px;">الاسم</span></div>
                                <div class="grandora-sign-line"><span style="width:56px;">Date</span><div class="line"></div><span dir="rtl" class="grandora-right grandora-bold" style="width:56px;">التاريخ</span></div>
                            </div>
                        </div>
                        <div class="grandora-bottom-panel grandora-delivered">
                            <div class="grandora-mb">Delivered By :</div>
                            <div class="grandora-delivered-box"></div>
                            <div class="grandora-mt">Date : ........................</div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>


    <template id="report_invoice_browser_print">
        <t t-call="web.html_container">
            <style type="text/css">
                @page {
                    size: A4 portrait;
                    margin: 0;
                }
                @media screen {
                    body {
                        background: #e9ecef !important;
                    }
                    .grandora-browser-print-toolbar {
                        position: sticky;
                        top: 0;
                        z-index: 1000;
                        display: flex;
                        justify-content: center;
                        gap: 8px;
                        padding: 12px;
                        background: rgba(248, 249, 250, 0.96);
                        border-bottom: 1px solid #d8dde2;
                        font-family: Arial, sans-serif;
                    }
                    .grandora-browser-print-toolbar button {
                        padding: 8px 14px;
                        border: 1px solid #714b67;
                        border-radius: 4px;
                        background: #714b67;
                        color: #fff;
                        font-size: 14px;
                        cursor: pointer;
                    }
                    .grandora-browser-print-toolbar .secondary {
                        background: #fff;
                        color: #714b67;
                    }
                    .grandora-invoice-page {
                        margin: 12px auto;
                        box-shadow: 0 0 10px rgba(0, 0, 0, .18);
                    }
                }
                @media print {
                    html, body {
                        width: 210mm;
                        min-height: 297mm;
                        margin: 0 !important;
                        padding: 0 !important;
                        background: #fff !important;
                    }
                    .grandora-browser-print-toolbar,
                    .no-print {
                        display: none !important;
                    }
                    .grandora-invoice-page {
                        margin: 0 !important;
                        box-shadow: none !important;
                    }
                    .grandora-lines tr,
                    .grandora-bottom-panel {
                        page-break-inside: avoid;
                    }
                }
            </style>
            <div class="grandora-browser-print-toolbar no-print">
                <button type="button" onclick="window.print();">Print / Save as PDF</button>
                <button type="button" class="secondary" onclick="window.close();">Close</button>
            </div>
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="account.report_invoice_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_inkjet_print">
        <t t-call="web.html_container">
            <style type="text/css">
                @page { size: Letter portrait; margin: 0; }
                html, body { width: 8.5in; min-height: 11in; margin: 0 !important; padding: 0 !important; background: #fff !important; }
                .grandora-inkjet-page {
                    --invoice-to-left: .65in; --invoice-to-top: 1.55in;
                    --invoice-meta-left: 4.80in; --invoice-meta-top: 1.60in;
                    --delivery-to-left: .65in; --delivery-to-top: 2.55in;
                    --delivery-meta-left: 4.80in; --delivery-meta-top: 2.55in;
                    --lines-left: .50in; --lines-top: 3.90in; --line-row-height: .24in;
                    --sl-column-left: .00in; --code-column-left: .30in; --description-column-left: 1.25in;
                    --uom-column-left: 4.90in; --quantity-column-left: 5.55in; --price-column-left: 6.40in; --amount-column-left: 7.15in;
                    --words-left: .95in; --words-top: 8.43in;
                    --total-left: 6.65in; --total-top: 8.43in;
                    --remarks-left: .95in; --remarks-top: 8.93in;
                    --delivered-by-left: 6.50in; --delivered-by-top: 9.55in;
                    --delivered-date-left: 6.70in; --delivered-date-top: 10.00in;
                    position: relative;
                    width: 8.5in;
                    height: 11in;
                    overflow: hidden;
                    color: #000;
                    font-family: "Times New Roman", Times, serif;
                    font-size: 10pt;
                    line-height: 1.15;
                }
                .grandora-inkjet-value { position: absolute; white-space: nowrap; }
                .grandora-inkjet-address { width: 3.45in; white-space: normal; }
                .grandora-inkjet-meta { width: 2.9in; }
                .grandora-inkjet-meta div { height: .20in; white-space: nowrap; }
                .grandora-inkjet-lines { position: absolute; left: var(--lines-left); top: var(--lines-top); width: 7.4in; }
                .grandora-inkjet-line { position: relative; height: var(--line-row-height); }
                .grandora-inkjet-line span { position: absolute; top: 0; white-space: nowrap; }
                .grandora-inkjet-sl { left: var(--sl-column-left); }
                .grandora-inkjet-code { left: var(--code-column-left); }
                .grandora-inkjet-description { left: var(--description-column-left); max-width: 3.1in; overflow: hidden; text-overflow: clip; }
                .grandora-inkjet-uom { left: var(--uom-column-left); }
                .grandora-inkjet-quantity { left: var(--quantity-column-left); }
                .grandora-inkjet-price { left: var(--price-column-left); }
                .grandora-inkjet-amount { left: var(--amount-column-left); }
                .grandora-inkjet-toolbar { display: none; }
                @media screen {
                    body { background: #e9ecef !important; }
                    .grandora-inkjet-toolbar { position: sticky; top: 0; z-index: 1000; display: flex; justify-content: center; gap: 8px; padding: 12px; background: rgba(248, 249, 250, .96); border-bottom: 1px solid #d8dde2; font-family: Arial, sans-serif; }
                    .grandora-inkjet-toolbar button { padding: 8px 14px; border: 1px solid #714b67; border-radius: 4px; background: #714b67; color: #fff; cursor: pointer; }
                    .grandora-inkjet-toolbar .secondary { background: #fff; color: #714b67; }
                    .grandora-inkjet-page { margin: 12px auto; box-shadow: 0 0 10px rgba(0, 0, 0, .18); }
                }
                @media print { .grandora-inkjet-toolbar { display: none !important; } }
            </style>
            <div class="grandora-inkjet-toolbar">
                <button type="button" onclick="window.print();">Print</button>
                <button type="button" class="secondary" onclick="window.close();">Close</button>
            </div>
            <t t-foreach="docs" t-as="o">
                <t t-set="delivery_partner" t-value="o._grandora_delivery_partner()"/>
                <t t-set="report_lines" t-value="o._grandora_report_lines()"/>
                <div class="grandora-inkjet-page">
                    <div class="grandora-inkjet-value grandora-inkjet-address" style="left:var(--invoice-to-left); top:var(--invoice-to-top);">
                        <div>INVOICE TO:</div>
                        <div t-esc="o.partner_id.name or ''"/>
                        <div><span t-esc="o.partner_id.street or ''"/><span t-if="o.partner_id.street and o.partner_id.street2">, </span><span t-esc="o.partner_id.street2 or ''"/></div>
                        <div><span t-esc="o.partner_id.city or ''"/><span t-if="o.partner_id.city and o.partner_id.country_id">, </span><span t-esc="o.partner_id.country_id.name or ''"/></div>
                        <div>Tel no: <span t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/></div>
                    </div>
                    <div class="grandora-inkjet-value grandora-inkjet-meta" style="left:var(--invoice-meta-left); top:var(--invoice-meta-top);">
                        <div>INVOICE NO : <span t-esc="o.name if o.name and o.name != '/' else 'Draft'"/></div>
                        <div>DATE : <span t-esc="o.invoice_date and o.invoice_date.strftime('%d/%m/%Y') or ''"/></div>
                        <div>CURRENCY : <span t-esc="o.currency_id.name or ''"/></div>
                        <div>P.O. NUMBER : <span t-esc="o.ref or ''"/></div>
                    </div>
                    <div class="grandora-inkjet-value grandora-inkjet-address" style="left:var(--delivery-to-left); top:var(--delivery-to-top);">
                        <div>DELIVERY TO:</div>
                        <div t-esc="delivery_partner.name or ''"/>
                        <div><span t-esc="delivery_partner.street or ''"/><span t-if="delivery_partner.street and delivery_partner.street2">, </span><span t-esc="delivery_partner.street2 or ''"/></div>
                        <div><span t-esc="delivery_partner.city or ''"/><span t-if="delivery_partner.city and delivery_partner.country_id">, </span><span t-esc="delivery_partner.country_id.name or ''"/></div>
                        <div>Tel no: <span t-esc="delivery_partner.phone or delivery_partner.mobile or ''"/></div>
                    </div>
                    <div class="grandora-inkjet-value grandora-inkjet-meta" style="left:var(--delivery-meta-left); top:var(--delivery-meta-top);">
                        <div>SALES PERSON : <span t-esc="o.invoice_user_id.name or o.user_id.name or ''"/></div>
                        <div>TERMS : <span t-esc="o.invoice_payment_term_id.name or ''"/></div>
                        <div>SO NUMBER : <span t-esc="o.sale_order_number or o.invoice_origin or ''"/></div>
                        <div>PRINTED : <span t-esc="o._grandora_printed_at()"/></div>
                    </div>

                    <!-- ponytail: this calibrated form fits 19 rows; add a continuation report if invoices exceed this capacity. -->
                    <div class="grandora-inkjet-lines">
                        <t t-foreach="report_lines" t-as="line">
                            <div t-if="line_index &lt; 19" class="grandora-inkjet-line">
                                <span class="grandora-inkjet-sl" t-esc="line_index + 1"/>
                                <span class="grandora-inkjet-code" t-esc="line.product_id.default_code or ''"/>
                                <span class="grandora-inkjet-description" t-esc="o._grandora_line_description(line)"/>
                                <span class="grandora-inkjet-uom" t-esc="line.product_uom_id.name or ''"/>
                                <span class="grandora-inkjet-quantity" t-esc="'%.3f' % line.quantity"/>
                                <span class="grandora-inkjet-price" t-esc="'%.2f' % line.price_unit"/>
                                <span class="grandora-inkjet-amount" t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
                            </div>
                        </t>
                    </div>

                    <div class="grandora-inkjet-value" style="left:var(--words-left); top:var(--words-top);" t-esc="o.amount_total_words or o.currency_id.amount_to_text(o.amount_total)"/>
                    <div class="grandora-inkjet-value" style="left:var(--total-left); top:var(--total-top);" t-esc="'{:,.2f}'.format(o.amount_total)"/>
                    <div class="grandora-inkjet-value" style="left:var(--remarks-left); top:var(--remarks-top);" t-esc="o.grandora_remarks or ''"/>
                    <div class="grandora-inkjet-value" style="left:var(--delivered-by-left); top:var(--delivered-by-top);" t-esc="o.invoice_user_id.name or o.user_id.name or ''"/>
                    <div class="grandora-inkjet-value" style="left:var(--delivered-date-left); top:var(--delivered-date-top);" t-esc="o.invoice_date and o.invoice_date.strftime('%d/%m/%Y') or ''"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
