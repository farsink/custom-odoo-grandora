<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Use OCA's per-product no-gap sequence policy. Grandora synchronizes
        product-derived prefixes without modifying the vendored OCA addon.
    -->
    <function model="ir.config_parameter" name="set_param">
        <value eval="'product_lot_sequence.policy'"/>
        <value eval="'product'"/>
    </function>

    <!-- Initialize/synchronize tracked products without resetting used counters. -->
    <function model="product.template" name="_grandora_sync_existing_lot_sequences"/>

    <!-- Backfill the stored editable lot name introduced on receipt rows. -->
    <function model="grandora.receipt.batch.line" name="_grandora_backfill_lot_names"/>

</odoo>
