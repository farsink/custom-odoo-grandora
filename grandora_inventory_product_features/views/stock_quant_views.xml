<odoo>
    <record id="view_stock_quant_tree_inventory_generate_lot" model="ir.ui.view">
        <field name="name">stock.quant.inventory.generate.lot</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <!-- Replace the empty lot selector with a clear batch-generation suggestion. -->
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="invisible">tracking == 'lot' and not lot_id</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="after">
                <button name="action_generate_inventory_lot"
                    string="Generate Batch Number"
                    type="object"
                    class="btn btn-link p-0"
                    invisible="tracking != 'lot' or lot_id or quantity != 0"/>
            </xpath>
        </field>
    </record>
</odoo>
