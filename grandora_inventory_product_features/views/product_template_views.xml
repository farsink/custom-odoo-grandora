<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_inventory_features" model="ir.ui.view">
        <field name="name">product.template.form.inventory.features</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="placeholder">Auto-generated if blank</attribute>
            </xpath>

            <xpath expr="//field[@name='barcode']" position="after">
                <field name="brand_id" options="{'no_create_edit': False}"/>
                <field name="item_group_id" options="{'no_create_edit': False}"/>
            </xpath>

            <xpath expr="//label[@for='standard_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='expiry_and_lots']" position="after">
                <group string="Receipt Batch Configuration" name="grandora_receipt_batch_requirements" invisible="tracking == 'none'">
                    <field name="minimum_shelf_life_days"/>
                </group>
            </xpath>

            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <label for="base_cost"/>
                <div name="grandora_cost_uom">
                    <field name="base_cost"
                           class="oe_inline"
                           widget="monetary"
                           options="{'currency_field': 'cost_currency_id', 'field_digits': True}"/>
                    <span groups="uom.group_uom">
                        per
                        <field name="uom_name" class="oe_inline"/>
                    </span>
                </div>
                <label for="landing_cost"/>
                <div name="grandora_landing_cost_uom">
                    <field name="landing_cost"
                           class="oe_inline"
                           widget="monetary"
                           options="{'currency_field': 'cost_currency_id', 'field_digits': True}"/>
                    <span groups="uom.group_uom">
                        per
                        <field name="uom_name" class="oe_inline"/>
                    </span>
                </div>
                <label for="total_cost"/>
                <div name="grandora_total_cost_uom">
                    <field name="total_cost"
                           class="oe_inline"
                           readonly="1"
                           widget="monetary"
                           options="{'currency_field': 'cost_currency_id', 'field_digits': True}"/>
                    <span groups="uom.group_uom">
                        per
                        <field name="uom_name" class="oe_inline"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_inventory_features" model="ir.ui.view">
        <field name="name">product.template.list.inventory.features</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="brand_id" optional="show"/>
                <field name="item_group_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="base_cost" widget="monetary" options="{'currency_field': 'cost_currency_id'}" optional="show"/>
                <field name="landing_cost" widget="monetary" options="{'currency_field': 'cost_currency_id'}" optional="show"/>
                <field name="total_cost" widget="monetary" options="{'currency_field': 'cost_currency_id'}" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_inventory_features" model="ir.ui.view">
        <field name="name">product.template.search.inventory.features</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="brand_id"/>
                <field name="item_group_id"/>
            </xpath>
            <xpath expr="//group/filter[@name='categ_id']" position="after">
                <filter string="Brand" name="group_by_brand_id" context="{'group_by':'brand_id'}"/>
                <filter string="Item Group" name="group_by_item_group_id" context="{'group_by':'item_group_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
