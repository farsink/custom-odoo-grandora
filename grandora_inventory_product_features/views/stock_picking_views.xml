<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_batch_entry" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.batch.entry</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_code']" position="after">
                <field name="show_batch_entry" invisible="1"/>
            </xpath>

            <!-- Put the only custom receipt action beside core Validate/Print. -->
            <xpath expr="//header/button[@name='do_print_picking']" position="before">
                <button name="action_generate_lots"
                        type="object"
                        string="Generate Lots"
                        class="btn btn-secondary"
                        groups="stock.group_stock_user"
                        invisible="not show_batch_entry or state in ('done', 'cancel')"/>
            </xpath>

            <!-- Add receipt batch entry before standard operations. -->
            <xpath expr="//page[@name='operations']" position="before">
                <page string="Receipt Batches" name="receipt_batches" invisible="not show_batch_entry">
                    <field name="batch_line_ids" readonly="state in ('done', 'cancel')">
                        <list editable="bottom">
                            <field name="move_id" string="Receipt Line"/>
                            <field name="product_id" readonly="1"/>
                            <field name="ordered_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1" optional="show"/>
                            <field name="received_qty"/>
                            <field name="supplier_lot"/>
                            <field name="expiry_date"/>
                            <field name="manufacture_date" optional="show"/>
                            <field name="quality_status" optional="show"/>
                            <field name="internal_lot_id" readonly="1" optional="show"/>
                            <field name="lot_name" readonly="internal_lot_id" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Receipt Batch Line form view for "Add Another Batch" -->
    <record id="grandora_receipt_batch_line_form_view" model="ir.ui.view">
        <field name="name">grandora.receipt.batch.line.form</field>
        <field name="model">grandora.receipt.batch.line</field>
        <field name="arch" type="xml">
            <form string="Receipt Batch">
                <sheet>
                    <group>
                        <field name="picking_id" invisible="1"/>
                        <field name="move_id" string="Receipt Line"/>
                        <field name="product_id" readonly="1"/>
                        <field name="ordered_qty" readonly="1"/>
                        <field name="received_qty"/>
                        <field name="supplier_lot"/>
                        <field name="expiry_date"/>
                        <field name="manufacture_date" optional="show"/>
                        <field name="quality_status"/>
                        <field name="internal_lot_id" readonly="1"/>
                        <field name="lot_name" readonly="internal_lot_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
