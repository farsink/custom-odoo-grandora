<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_item_group_view_list" model="ir.ui.view">
        <field name="name">product.item.group.list</field>
        <field name="model">product.item.group</field>
        <field name="arch" type="xml">
            <list string="Product Item Groups" editable="bottom">
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="product_item_group_view_form" model="ir.ui.view">
        <field name="name">product.item.group.form</field>
        <field name="model">product.item.group</field>
        <field name="arch" type="xml">
            <form string="Product Item Group">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="note" placeholder="Optional notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_item_group_view_search" model="ir.ui.view">
        <field name="name">product.item.group.search</field>
        <field name="model">product.item.group</field>
        <field name="arch" type="xml">
            <search string="Product Item Groups">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="product_item_group_action" model="ir.actions.act_window">
        <field name="name">Item Groups</field>
        <field name="res_model">product.item.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_item_group_view_search"/>
    </record>

    <menuitem id="product_item_group_menu"
              name="Item Groups"
              parent="stock.menu_product_in_config_stock"
              action="product_item_group_action"
              sequence="36"
              groups="stock.group_stock_manager"/>
</odoo>
