<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_inherit" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']/group[2]" position="inside">
                <field name="supplier_lot" readonly="id"/>
                <field name="purchase_order_id" readonly="1"/>
                <field name="receipt_id" readonly="1"/>
                <field name="manufacture_date"/>
                <field name="quality_status"/>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_search_inherit" model="ir.ui.view">
        <field name="name">stock.lot.search.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="supplier_lot"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_product']" position="after">
                <filter string="Supplier Batch" name="filter_supplier_lot"
                        domain="[('supplier_lot', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_tree_inherit" model="ir.ui.view">
        <field name="name">stock.lot.tree.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="supplier_lot" optional="show"/>
                <field name="purchase_order_id" optional="show"/>
                <field name="expiration_date" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
