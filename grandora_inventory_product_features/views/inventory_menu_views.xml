<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_inventory_product_template_default" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="product.product_template_tree_view"/>
        <field name="context">{'search_default_goods': 1, 'default_is_storable': True}</field>
    </record>

    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="action" ref="action_inventory_product_template_default"/>
    </record>
</odoo>
