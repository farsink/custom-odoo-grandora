<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_brand_view_list" model="ir.ui.view">
        <field name="name">product.brand.list</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="name"/>
                <field name="supplier_id" optional="show"/>
                <field name="website" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="product_brand_view_form" model="ir.ui.view">
        <field name="name">product.brand.form</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Boiron"/></h1>
                    </div>
                    <group>
                        <field name="active"/>
                        <field name="supplier_id"/>
                        <field name="website" widget="url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_brand_view_search" model="ir.ui.view">
        <field name="name">product.brand.search</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <search string="Brands">
                <field name="name"/>
                <field name="supplier_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_product_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_brand_view_search"/>
    </record>

    <menuitem id="menu_product_brand_config_stock"
              name="Brands"
              parent="stock.menu_product_in_config_stock"
              action="action_product_brand"
              sequence="6"
              groups="stock.group_stock_manager"/>
</odoo>
