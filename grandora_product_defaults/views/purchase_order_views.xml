<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_grandora_product_info" model="ir.ui.view">
        <field name="name">purchase.order.form.grandora.product.info</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="after">
                <field name="brand_id" readonly="1" optional="show"/>
                <field name="item_group_id" readonly="1" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="brand_id" readonly="1"/>
                <field name="item_group_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
