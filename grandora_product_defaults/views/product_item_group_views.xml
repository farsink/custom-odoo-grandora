<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_item_group_view_list" model="ir.ui.view">
        <field name="name">product.item.group.list</field>
        <field name="model">product.item.group</field>
        <field name="arch" type="xml">
            <list string="Item Groups">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="default_categ_id" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="product_item_group_view_form" model="ir.ui.view">
        <field name="name">product.item.group.form</field>
        <field name="model">product.item.group</field>
        <field name="arch" type="xml">
            <form string="Item Group">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Frozen"/></h1>
                    </div>
                    <group>
                        <field name="active"/>
                        <field name="code" placeholder="e.g. FRZ"/>
                        <field name="default_categ_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_item_group_view_search" model="ir.ui.view">
        <field name="name">product.item.group.search</field>
        <field name="model">product.item.group</field>
        <field name="arch" type="xml">
            <search string="Item Groups">
                <field name="name"/>
                <field name="code"/>
                <field name="default_categ_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="1" string="Group By">
                    <filter string="Default Category" name="group_by_default_categ_id" context="{'group_by':'default_categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_item_group" model="ir.actions.act_window">
        <field name="name">Item Groups</field>
        <field name="res_model">product.item.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_item_group_view_search"/>
    </record>

    <menuitem id="menu_product_item_group_config_stock"
              name="Item Groups"
              parent="stock.menu_product_in_config_stock"
              action="action_product_item_group"
              sequence="7"
              groups="stock.group_stock_manager"/>
</odoo>
