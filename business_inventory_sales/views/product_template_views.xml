<odoo>
    <record id="product_template_form_business_inventory_sales" model="ir.ui.view">
        <field name="name">product.template.form.business.inventory.sales</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="x_business_sku"/>
            </field>
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Business Replenishment Notes">
                    <field name="x_reorder_note" placeholder="Internal note for stock/sales planning..."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
